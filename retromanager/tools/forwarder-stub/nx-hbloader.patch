+static bool g_forwarderStarted = false;
+
+static bool readDataStorage(void* ctx, uint64_t offset, void* buf, size_t size)
+{
+    return R_SUCCEEDED(fsStorageRead((FsStorage*)ctx, (s64)offset, buf, size));
+}
+
+static void loadForwarderTarget(void)
+{
+    FsStorage storage;
+    if (R_FAILED(fsOpenDataStorageByCurrentProcess(&storage)))
+        diagAbortWithResult(MAKERESULT(Module_HomebrewLoader, 100));
+
+    long pathLen = rl_read_root_file(readDataStorage, &storage, "nextNroPath", g_nextNroPath, sizeof g_nextNroPath);
+    long argvLen = rl_read_root_file(readDataStorage, &storage, "nextArgv", g_nextArgv, sizeof g_nextArgv);
+    fsStorageClose(&storage);
+
+    if (pathLen <= 0)
+        diagAbortWithResult(MAKERESULT(Module_HomebrewLoader, 101));
+    if (argvLen <= 0)
+        memcpy(g_nextArgv, g_nextNroPath, (size_t)pathLen + 1);
+}
+
