<brls:Box
    width="auto"
    height="auto"
    axis="row"
    alignItems="center"
    focusable="true"
    paddingTop="12"
    paddingBottom="12"
    paddingLeft="@style/brls/sidebar/item_accent_margin_sides"
    paddingRight="@style/brls/sidebar/item_accent_margin_sides">

    <brls:Box
        width="auto"
        height="auto"
        axis="column"
        grow="1.0">

        <brls:Label
            id="game/title"
            width="auto"
            height="auto"
            singleLine="true"
            fontSize="@style/brls/sidebar/item_font_size" />

        <brls:Label
            id="game/detail"
            width="auto"
            height="auto"
            singleLine="true"
            fontSize="16"
            textColor="@theme/brls/text_disabled"
            marginTop="4" />
    </brls:Box>

    <!-- "Installed" tag, shown when the ROM is already on the SD card. -->
    <brls:Label
        id="game/installed"
        visibility="gone"
        text="@i18n/retromanager/shop/installed"
        fontSize="16"
        textColor="@theme/brls/accent"
        marginLeft="20" />
</brls:Box>
