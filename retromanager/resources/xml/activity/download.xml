<brls:AppletFrame>
    <brls:Box
        id="download/root"
        title="@i18n/retromanager/download/title"
        icon="@res/img/icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="center"
        justifyContent="center"
        grow="1.0">

        <brls:Label
            id="download/title"
            fontSize="30"
            horizontalAlign="center"
            marginBottom="8" />

        <brls:Label
            id="download/destination"
            fontSize="16"
            textColor="@theme/brls/text_disabled"
            horizontalAlign="center"
            marginBottom="40" />

        <!-- Progress bar: a track and a fill whose width is a percentage. -->
        <brls:Box
            id="download/track"
            width="800"
            height="14"
            cornerRadius="7"
            backgroundColor="@theme/brls/backdrop"
            marginBottom="16">
            <brls:Rectangle
                id="download/fill"
                width="0"
                height="14"
                cornerRadius="7"
                color="@theme/brls/accent" />
        </brls:Box>

        <brls:Label
            id="download/stats"
            fontSize="18"
            horizontalAlign="center"
            marginBottom="24" />

        <brls:Label
            id="download/status"
            width="900"
            horizontalAlign="center"
            marginBottom="40" />

        <brls:Button
            id="download/action"
            style="bordered"
            width="300"
            text="@i18n/retromanager/download/cancel" />
    </brls:Box>
</brls:AppletFrame>
