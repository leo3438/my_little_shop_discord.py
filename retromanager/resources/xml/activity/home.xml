<brls:AppletFrame>
    <brls:Box
        title="@i18n/retromanager/app/title"
        icon="@res/img/icon.jpg"
        width="auto"
        height="auto"
        axis="column"
        alignItems="center"
        justifyContent="center"
        grow="1.0">

        <brls:Label
            text="@i18n/retromanager/home/welcome"
            fontSize="32"
            horizontalAlign="center"
            marginBottom="12" />

        <brls:Label
            text="@i18n/retromanager/home/subtitle"
            horizontalAlign="center"
            marginBottom="28" />

        <!-- 2 x 2 grid: shop and app store, then saves and BIOS; the download queue below. -->
        <brls:Box axis="row" marginBottom="16">
            <brls:Button
                id="home/open_shop"
                style="primary"
                width="380"
                text="@i18n/retromanager/shop/open"
                marginRight="16" />
            <brls:Button
                id="home/apps"
                style="primary"
                width="380"
                text="@i18n/retromanager/apps/open" />
        </brls:Box>
        <brls:Box axis="row" marginBottom="16">
            <brls:Button
                id="home/sync_saves"
                style="bordered"
                width="380"
                text="@i18n/retromanager/sync/open"
                marginRight="16" />
            <brls:Button
                id="home/bios"
                style="bordered"
                width="380"
                text="@i18n/retromanager/bios/open" />
        </brls:Box>
        <brls:Box axis="row" marginBottom="24">
            <brls:Button
                id="home/downloads"
                style="bordered"
                width="380"
                text="@i18n/retromanager/downloads/title"
                marginRight="16" />
            <brls:Button
                id="home/sources"
                style="bordered"
                width="380"
                text="@i18n/retromanager/sources/title" />
        </brls:Box>

        <brls:Label id="home/platform" horizontalAlign="center" marginBottom="10" />
        <brls:Label id="home/sd_root" horizontalAlign="center" marginBottom="10" />
        <brls:Label id="home/shop" horizontalAlign="center" marginBottom="10" />
        <brls:Label id="home/saves" horizontalAlign="center" marginBottom="10" />
        <brls:Label id="home/retroarch" horizontalAlign="center" />

        <brls:Label
            id="home/version"
            fontSize="16"
            horizontalAlign="center"
            marginTop="24" />
    </brls:Box>
</brls:AppletFrame>
