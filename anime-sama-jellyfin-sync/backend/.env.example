# ---------------------------------------------------------------------------
# Anime-Sama -> Jellyfin sync : configuration du backend
# Copiez ce fichier en `.env` puis adaptez les valeurs.
# ---------------------------------------------------------------------------

# --- Serveur HTTP local (reçoit les webhooks de l'extension) ---------------
HOST=127.0.0.1
PORT=8000

# Origines autorisées pour le CORS (l'extension envoie depuis anime-sama).
# Séparez plusieurs origines par des virgules. "*" accepte tout (pratique en dev).
CORS_ORIGINS=*

# --- Base de données -------------------------------------------------------
# URL SQLAlchemy. Par défaut un fichier SQLite local.
DATABASE_URL=sqlite:///./data/episodes.db

# --- Stockage des vidéos ---------------------------------------------------
# Racine de la bibliothèque Jellyfin (montée en local ou via un partage réseau).
# La structure /{Anime}/Season {SS}/... y est créée automatiquement.
MEDIA_ROOT=./media

# --- Téléchargement --------------------------------------------------------
# Outil utilisé : "yt-dlp" (recommandé, gère .m3u8 et les hébergeurs) ou "aria2c".
DOWNLOADER=yt-dlp

# Chemins vers les binaires si ils ne sont pas dans le PATH.
YTDLP_PATH=yt-dlp
ARIA2C_PATH=aria2c

# User-Agent envoyé lors du téléchargement (doit ressembler à un vrai navigateur).
DOWNLOAD_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# Nombre maximum de téléchargements simultanés.
MAX_CONCURRENT_DOWNLOADS=1

# --- Jellyfin --------------------------------------------------------------
# URL de base de votre serveur Jellyfin.
JELLYFIN_URL=http://localhost:8096
# Clé API Jellyfin (Tableau de bord -> Clés API).
JELLYFIN_API_KEY=changeme
# Mettez à false pour désactiver le rafraîchissement automatique de la bibliothèque.
JELLYFIN_REFRESH_ENABLED=true
