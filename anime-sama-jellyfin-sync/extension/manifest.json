{
  "manifest_version": 3,
  "name": "Anime-Sama / Afterdark -> Jellyfin Sync",
  "version": "1.1.0",
  "description": "Capture les métadonnées et le flux vidéo des contenus regardés sur Anime-Sama et Afterdark, puis les envoie au backend local pour intégration dans Jellyfin.",

  "permissions": [
    "webRequest",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "*://anime-sama.fr/*",
    "*://*.anime-sama.fr/*",
    "*://afd926.mom/*",
    "*://*.afd926.mom/*",
    "*://*.mom/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://anime-sama.fr/*",
        "*://*.anime-sama.fr/*",
        "*://afd926.mom/*",
        "*://*.afd926.mom/*",
        "*://*.mom/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Anime-Sama / Afterdark -> Jellyfin",
    "default_popup": "popup.html"
  }
}
