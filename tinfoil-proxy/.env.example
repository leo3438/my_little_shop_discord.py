# ===========================================================================
#  Configuration du proxy/agrégateur Tinfoil
#  Copiez ce fichier en « .env » puis renseignez vos valeurs :
#      cp .env.example .env
# ===========================================================================

# --- Serveur -----------------------------------------------------------------
# Port d'écoute local du proxy (celui que vous mettrez dans Tinfoil).
PORT=3000

# URL publique utilisée pour construire les liens de téléchargement renvoyés
# dans l'index Tinfoil. Doit être joignable depuis la Switch.
# Ex : http://192.168.1.50:3000  ou  https://mon-proxy.exemple.com
PUBLIC_BASE_URL=http://localhost:3000

# --- Source 1 : UltraNX ------------------------------------------------------
# Base de l'API distante UltraNX (sans slash final).
ULTRANX_API_BASE=https://api.ultranx.example.com

# Cookie réseau UltraNX. Injecté tel quel dans l'en-tête :
#     Cookie: auth_token=VALEUR
ULTRANX_AUTH_TOKEN=

# --- Source 2 : Magic Monkei -------------------------------------------------
# Base de l'API distante Magic Monkei (sans slash final).
MAGIC_MONKEI_API_BASE=https://cyberfoil.magicmonkei.com

# Identifiants pour l'authentification HTTP Basic sur Magic Monkei.
MAGIC_MONKEI_USER=
MAGIC_MONKEI_PASS=
