# ===========================================================================
#  Configuration du proxy/agrégateur Tinfoil
#  Copiez ce fichier en « .env » puis renseignez vos valeurs :
#      cp .env.example .env
# ===========================================================================

# --- Serveur -----------------------------------------------------------------
# Port d'écoute local du proxy (celui que vous mettrez dans Tinfoil).
PORT=3000

# URL publique utilisée pour réécrire les liens de l'index Tinfoil.
# Doit être joignable depuis la Switch.
# Ex : http://192.168.1.50:3001  ou  https://mon-proxy.exemple.com
PUBLIC_BASE_URL=http://localhost:3000

# (Optionnel) User-Agent Tinfoil utilisé pour Magic Monkei (et par défaut). Le
# UA Node par défaut est souvent rejeté (Cloudflare). Défaut : Tinfoil/17.0.
# Vous pouvez mettre un UA de navigateur si une source l'exige, ex. :
#   PROXY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
# PROXY_USER_AGENT=Tinfoil/17.0

# --- Source 1 : UltraNX (simulation DBI) -------------------------------------
# Connexion façon DBI : les identifiants sont injectés dans le chemin de l'URL
#     https://dbi.ultranx.ru/link/{ULTRANX_LOGIN}/{ULTRANX_PASSWORD}/
ULTRANX_LOGIN=
ULTRANX_PASSWORD=
# (Optionnel) Base amont, sans le segment login/password ni slash final.
# ULTRANX_BASE_URL=https://dbi.ultranx.ru/link
# (Optionnel) User-Agent DBI. UltraNX refuse les requêtes sans « device info ».
# ULTRANX_USER_AGENT=DBI/755
# (Optionnel) En-têtes supplémentaires simulant DBI, si les valeurs par défaut
# ne suffisent pas. JSON, ou lignes « Clé: Valeur » séparées par des ; .
# Renseignez ici les en-têtes exacts capturés depuis une vraie session DBI.
#   ULTRANX_HEADERS={"Device-Id":"XXXX","DBI-Version":"755"}

# --- Source 2 : Magic Monkei (simulation Tinfoil) ----------------------------
# Connexion façon Tinfoil : authentification HTTP Basic.
MAGIC_MONKEI_USER=
MAGIC_MONKEI_PASS=
# (Optionnel) URL de l'index Tinfoil amont. Le fichier JSON est « shop.tfl »
# (le dossier /tinfoil/ renvoie un listing HTML, pas du JSON).
# MAGIC_MONKEI_INDEX_URL=https://shop.magicmonkei.com/tinfoil/shop.tfl

# --- Jaquettes IGDB (interface /web) -----------------------------------------
# Identifiants d'application Twitch pour l'API IGDB (https://api-docs.igdb.com).
# Créez une app sur https://dev.twitch.tv/console/apps pour obtenir ces valeurs.
# Laissez vide pour désactiver : l'UI affichera alors le placeholder de jaquette.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# (Optionnel) Consoles supplémentaires à reconnaître dans le menu déroulant, si
# une plateforme utilisée par Magic Monkei n'est pas déjà connue. Liste séparée
# par des virgules, ex. :
#   EXTRA_CONSOLES=Amstrad CPC,ZX Spectrum
