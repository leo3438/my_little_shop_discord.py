# ===========================================================================
#  Configuration du proxy/agrégateur Tinfoil
#  Copiez ce fichier en « .env » puis renseignez vos valeurs :
#      cp .env.example .env
# ===========================================================================

# --- Serveur -----------------------------------------------------------------
# Port d'écoute local du proxy (celui que vous mettrez dans Tinfoil).
PORT=3000

# URL publique utilisée pour réécrire les liens de l'index Tinfoil.
# Doit être joignable depuis la Switch.
# Ex : http://192.168.1.50:3001  ou  https://mon-proxy.exemple.com
PUBLIC_BASE_URL=http://localhost:3000

# --- Source 1 : UltraNX (simulation DBI) -------------------------------------
# Connexion façon DBI : les identifiants sont injectés dans le chemin de l'URL
#     https://dbi.ultranx.ru/link/{ULTRANX_LOGIN}/{ULTRANX_PASSWORD}/
ULTRANX_LOGIN=
ULTRANX_PASSWORD=
# (Optionnel) Base amont, sans le segment login/password ni slash final.
# ULTRANX_BASE_URL=https://dbi.ultranx.ru/link

# --- Source 2 : Magic Monkei (simulation Tinfoil) ----------------------------
# Connexion façon Tinfoil : authentification HTTP Basic.
MAGIC_MONKEI_USER=
MAGIC_MONKEI_PASS=
# (Optionnel) URL de l'index Tinfoil amont.
# MAGIC_MONKEI_INDEX_URL=https://shop.magicmonkei.com/tinfoil
